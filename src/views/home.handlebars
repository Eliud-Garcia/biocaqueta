<h1 class="h3 mb-4">Avistamientos registrados</h1>

{{#if error}}
<div class="alert alert-danger" role="alert">{{error}}</div>
{{/if}}

<section class="card mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Registrar nuevo avistamiento</h2>
    </div>
    <div class="card-body">
        <form action="/api/avistamientos" method="POST" class="row g-3">
            <div class="col-md-6">
                <label for="nombreComun" class="form-label">Nombre común</label>
                <input type="text" class="form-control" id="nombreComun" name="nombreComun"
                       placeholder="Ej. Danta amazónica" required>
            </div>

            <div class="col-md-6">
                <label for="nombreCientifico" class="form-label">Nombre científico</label>
                <input type="text" class="form-control" id="nombreCientifico" name="nombreCientifico"
                       placeholder="Ej. Tapirus terrestris" required>
            </div>

            <div class="col-md-4">
                <label for="categoria" class="form-label">Categoría</label>
                <select class="form-select" id="categoria" name="categoria" required>
                    <option value="" selected disabled>Seleccione...</option>
                    <option value="Mamífero">Mamífero</option>
                    <option value="Ave">Ave</option>
                    <option value="Reptil">Reptil</option>
                    <option value="Anfibio">Anfibio</option>
                    <option value="Flora">Flora</option>
                </select>
            </div>

            <div class="col-md-4">
                <label for="zona" class="form-label">Zona</label>
                <input type="text" class="form-control" id="zona" name="zona"
                       placeholder="Ej. Río Hacha" required>
            </div>

            <div class="col-md-4">
                <label for="estadoConservacion" class="form-label">Estado de conservación</label>
                <select class="form-select" id="estadoConservacion" name="estadoConservacion">
                    <option value="Preocupación menor" selected>Preocupación menor</option>
                    <option value="Vulnerable">Vulnerable</option>
                    <option value="En peligro">En peligro</option>
                </select>
            </div>

            <div class="col-md-6">
                <label for="investigador" class="form-label">Investigador</label>
                <input type="text" class="form-control" id="investigador" name="investigador"
                       placeholder="Nombre del estudiante o docente" required>
            </div>

            <div class="col-md-6">
                <label for="fechaRegistro" class="form-label">Fecha de registro</label>
                <input type="date" class="form-control" id="fechaRegistro" name="fechaRegistro">
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success">Guardar avistamiento</button>
            </div>
        </form>
    </div>
</section>

<section class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Listado de avistamientos</h2>
        <span class="badge text-bg-success">{{avistamientos.length}} registro(s)</span>
    </div>
    <div class="card-body p-0">
        {{#if avistamientos.length}}
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-success">
                    <tr>
                        <th>Nombre común</th>
                        <th>Nombre científico</th>
                        <th>Categoría</th>
                        <th>Zona</th>
                        <th>Estado de conservación</th>
                        <th>Investigador</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each avistamientos}}
                    <tr>
                        <td>{{nombreComun}}</td>
                        <td><em>{{nombreCientifico}}</em></td>
                        <td>{{categoria}}</td>
                        <td>{{zona}}</td>
                        <td>{{estadoConservacion}}</td>
                        <td>{{investigador}}</td>
                        <td>{{formatoFecha fechaRegistro}}</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/editar/{{_id}}" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form action="/api/avistamientos/delete/{{_id}}" method="POST"
                                      onsubmit="return confirm('¿Seguro que desea eliminar este avistamiento?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <p class="text-center text-muted py-4 mb-0">
            Todavía no hay avistamientos registrados. Use el formulario de arriba para crear el primero.
        </p>
        {{/if}}
    </div>
</section>
